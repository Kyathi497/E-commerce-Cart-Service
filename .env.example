# Values for running on your machine (`pnpm dev`) against the Docker database
# (`docker compose up mysql`). Inside Docker Compose, hosts and ports are
# overridden in docker-compose.yml.
PORT=4004

DB_HOST=localhost
DB_PORT=3310
MYSQL_USER=cart
MYSQL_PASSWORD=cart
MYSQL_DATABASE=cart

# auth-service's public keys, for knowing which shopper is signed in.
AUTH_JWKS_URL=http://localhost:4001/internal/.well-known/jwks.json
# Shared by all services for service-to-service calls. Required in production
# (at least 32 random characters, e.g. `openssl rand -base64 48`).
# SERVICE_TOKEN_SECRET=

# What a priced cart asks.
CATALOG_URL=http://localhost:4002
INVENTORY_URL=http://localhost:4003
PROMOTION_URL=http://localhost:4005
SHIPPING_URL=http://localhost:4008
# Shipping shown when shipping-service can't be reached.
FALLBACK_SHIPPING_PAISE=7000

# Guest carts untouched for this many days are deleted.
GUEST_CART_DAYS=30
# The tej_cart cookie is HTTPS-only by default in production; override here.
# COOKIE_SECURE=false
